{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoidScript",
  "version": "5.4.1",
  "identifier": "app.voidscript.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VoidScript",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0b0d13"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "VoidScript",
    "shortDescription": "AI agent for Roblox Studio",
    "longDescription": "VoidScript runs the local bridge that lets AI build in Roblox Studio, with a built-in chat, tools terminal and live Studio status.",
    "copyright": "GPL-3.0-or-later"
  }
}
